{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Nutzungshinweis",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "Privates, inoffizielles Projekt – nicht von Dreame."
        },
        {
          "type": "Label",
          "caption": "Nutzt die Cloud der Dreamehome-App mit deinem Konto. Dreame kann das jederzeit ändern."
        },
        {
          "type": "CheckBox",
          "name": "Consent",
          "caption": "Gelesen – Nutzung auf eigene Verantwortung"
        }
      ]
    },
    {
      "type": "CheckBox",
      "name": "Active",
      "caption": "Instanz aktiv"
    },
    {
      "type": "ExpansionPanel",
      "caption": "Status",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "name": "StatusCloud",
          "caption": "Cloud: –"
        },
        {
          "type": "Label",
          "name": "StatusLive",
          "caption": "Live-Verbindung: –"
        },
        {
          "type": "Label",
          "name": "StatusCert",
          "caption": "Server-Zertifikat: –"
        },
        {
          "type": "Label",
          "name": "StatusMessage",
          "caption": "Letzte Meldung: –"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Konto & Gerät",
      "expanded": true,
      "items": [
        {
          "type": "Label",
          "caption": "Zugangsdaten der Dreamehome-App (Passwort wird nur als Hash gespeichert)."
        },
        {
          "type": "ValidationTextBox",
          "name": "Email",
          "caption": "E-Mail"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "Passwort"
        },
        {
          "type": "Select",
          "name": "Region",
          "caption": "Region",
          "options": [
            {
              "caption": "Europa",
              "value": "eu"
            },
            {
              "caption": "USA",
              "value": "us"
            },
            {
              "caption": "China",
              "value": "cn"
            },
            {
              "caption": "Singapur",
              "value": "sg"
            },
            {
              "caption": "Korea",
              "value": "kr"
            },
            {
              "caption": "Russland",
              "value": "ru"
            }
          ]
        },
        {
          "type": "ValidationTextBox",
          "name": "DeviceFilter",
          "caption": "Gerät (nur bei mehreren Robotern)"
        },
        {
          "type": "CheckBox",
          "name": "VerifyTLS",
          "caption": "Zertifikate prüfen"
        },
        {
          "type": "CheckBox",
          "name": "Live",
          "caption": "Live-Verbindung (Echtzeit)"
        },
        {
          "type": "Label",
          "caption": "Wie in der App: Zustand und Karte sofort. Richtet sich selbst ein; bei Ausfall normale Abfrage."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "NumberSpinner",
              "name": "Interval",
              "caption": "Abfrage in Ruhe",
              "suffix": "s",
              "minimum": 30,
              "maximum": 3600
            },
            {
              "type": "NumberSpinner",
              "name": "IntervalBusy",
              "caption": "beim Reinigen",
              "suffix": "s",
              "minimum": 10,
              "maximum": 300
            }
          ]
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "Button",
              "caption": "Verbindung testen",
              "onClick": "SAUG_TestConnection($id);"
            },
            {
              "type": "Button",
              "caption": "Gerät scannen",
              "onClick": "SAUG_ScanDevice($id);",
              "confirm": "Fragt rund 2.800 Kennungen ab (ca. 20–40 Sekunden). Fortfahren?"
            },
            {
              "type": "Button",
              "caption": "Live neu verbinden",
              "onClick": "SAUG_LiveRestart($id);"
            },
            {
              "type": "Button",
              "caption": "Zertifikat neu übernehmen",
              "onClick": "SAUG_LiveTrustCertificate($id);",
              "confirm": "Nur nötig, wenn Dreame das Zertifikat des Live-Servers erneuert hat. Wirklich neu übernehmen?"
            }
          ]
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Etagen & Räume",
      "items": [
        {
          "type": "Label",
          "caption": "Liest Karten und Räume aus der App. Nach Neukartierung erneut einlesen."
        },
        {
          "type": "RowLayout",
          "items": [
            {
              "type": "Button",
              "caption": "Karten & Räume einlesen",
              "onClick": "SAUG_ReadMaps($id);"
            },
            {
              "type": "Button",
              "caption": "Kartendiagnose",
              "onClick": "SAUG_MapDiagnosis($id);"
            }
          ]
        },
        {
          "type": "Label",
          "caption": "„Verwenden“ aus = Raum ausblenden. „Eigener Name“ = Anzeigename."
        },
        {
          "type": "List",
          "name": "Rooms",
          "caption": "Räume",
          "rowCount": 12,
          "add": false,
          "delete": false,
          "columns": [
            {
              "caption": "Verwenden",
              "name": "use",
              "width": "100px",
              "edit": {
                "type": "CheckBox"
              }
            },
            {
              "caption": "Etage",
              "name": "floor",
              "width": "120px",
              "save": true
            },
            {
              "caption": "Karte",
              "name": "map",
              "width": "60px",
              "save": true
            },
            {
              "caption": "Nr.",
              "name": "seg",
              "width": "50px",
              "save": true
            },
            {
              "caption": "Name in der App",
              "name": "app",
              "width": "180px",
              "save": true
            },
            {
              "caption": "Eigener Name",
              "name": "alias",
              "width": "auto",
              "edit": {
                "type": "ValidationTextBox"
              }
            }
          ]
        }
      ]
    },
